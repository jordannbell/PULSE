@page "/forgot-password"
@inject PulseApiClient Api

<PageTitle>Mot de passe oublié, Pulse</PageTitle>

<section class="auth">
    <h1>Mot de passe oublié</h1>

    @if (_sent)
    {
        <p class="notice notice-ok" role="status">
            Si un compte existe avec cette adresse, un e-mail vient d'être envoyé avec un lien pour choisir un nouveau mot de passe.
            Le lien est valable une heure.
        </p>
        <p class="auth-links"><a href="/login">Retour à la connexion</a></p>
    }
    else
    {
        <p class="muted">Saisissez l'adresse de votre compte : nous vous envoyons un lien pour en choisir un nouveau.</p>
        <EditForm Model="Model" FormName="forgot-password" OnSubmit="SubmitAsync">
            <div class="fields">
                <div class="field">
                    <label for="email">Adresse e-mail</label>
                    <InputText id="email" type="email" @bind-Value="Model.Email" autocomplete="username" />
                </div>
            </div>
            @if (_problem is not null)
            {
                <p class="notice notice-error" role="alert">@_problem</p>
            }

            <button type="submit" class="btn btn-block">Envoyer le lien</button>
        </EditForm>
        <p class="auth-links"><a href="/login">Retour à la connexion</a></p>
    }
</section>

@code {
    private bool _sent;
    private string? _problem;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ForgotModel Model { get; set; } = default!;

    protected override void OnInitialized() => Model ??= new();

    private async Task SubmitAsync()
    {
        var result = await Api.ForgotPasswordAsync(Model.Email, HttpContext.RequestAborted);

        // The answer is the same whether or not the address has an account: only real failures are shown.
        switch (result.Status)
        {
            case ApiStatus.Ok:
            case ApiStatus.Invalid:
                _sent = true;
                break;
            case ApiStatus.TooManyRequests:
                _problem = "Trop de demandes. Patientez une minute avant de réessayer.";
                break;
            default:
                _problem = "Le service ne répond pas pour le moment. Réessayez dans un instant.";
                break;
        }
    }

    private sealed class ForgotModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
