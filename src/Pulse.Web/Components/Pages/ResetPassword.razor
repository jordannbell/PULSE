@page "/reset-password"
@inject PulseApiClient Api

<PageTitle>Nouveau mot de passe, Pulse</PageTitle>

<section class="auth">
    <h1>Nouveau mot de passe</h1>

    @if (_done)
    {
        <p class="notice notice-ok" role="status">Votre mot de passe est changé. Toutes vos sessions ont été fermées par sécurité.</p>
        <p class="auth-links"><a class="btn" href="/login">Se connecter</a></p>
    }
    else if (string.IsNullOrEmpty(Token) && string.IsNullOrEmpty(Model.Token))
    {
        <p class="notice notice-error" role="alert">Ce lien n'est pas valide. <a href="/forgot-password">Demander un nouveau lien</a>.</p>
    }
    else
    {
        <EditForm Model="Model" FormName="reset-password" OnSubmit="SubmitAsync">
            <InputText type="hidden" @bind-Value="Model.Token" />
            <div class="fields">
                <div class="field">
                    <label for="password">Nouveau mot de passe</label>
                    <InputText id="password" type="password" @bind-Value="Model.NewPassword" autocomplete="new-password" />
                    <span class="field-hint">10 caractères au minimum.</span>
                    <FieldError Errors="_errors" Field="password" />
                </div>
            </div>
            @if (_errors.ContainsKey("token"))
            {
                <p class="notice notice-error" role="alert">Ce lien n'est plus valable. <a href="/forgot-password">Demander un nouveau lien</a>.</p>
            }

            @if (_problem is not null)
            {
                <p class="notice notice-error" role="alert">@_problem</p>
            }

            <button type="submit" class="btn btn-block">Changer le mot de passe</button>
        </EditForm>
    }
</section>

@code {
    private IReadOnlyDictionary<string, string[]> _errors = new Dictionary<string, string[]>();
    private string? _problem;
    private bool _done;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ResetModel Model { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new();
        if (string.IsNullOrEmpty(Model.Token))
        {
            Model.Token = Token ?? string.Empty;
        }
    }

    private async Task SubmitAsync()
    {
        var result = await Api.ResetPasswordAsync(new ResetPasswordRequest(Model.Token, Model.NewPassword), HttpContext.RequestAborted);
        switch (result.Status)
        {
            case ApiStatus.Ok:
                _done = true;
                break;
            case ApiStatus.Invalid:
                _errors = result.Errors ?? _errors;
                break;
            case ApiStatus.TooManyRequests:
                _problem = "Trop de tentatives. Patientez une minute avant de réessayer.";
                break;
            default:
                _problem = "Le service ne répond pas pour le moment. Réessayez dans un instant.";
                break;
        }
    }

    private sealed class ResetModel
    {
        public string Token { get; set; } = string.Empty;

        public string NewPassword { get; set; } = string.Empty;
    }
}
