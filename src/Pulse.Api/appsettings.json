{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Pulse": "Data Source=pulse.db"
  },
  "Pulse": {
    "FailureThreshold": 3,
    "MaxParallelProbes": 10,
    "RetentionDays": 90,
    "SchedulerTickSeconds": 5,
    "SchedulerEnabled": true,
    "AllowPrivateTargets": false,
    "SeedDemoData": false,
    "TrustForwardedHeaders": false,
    "Accounts": {
      "SessionDays": 7,
      "AutoVerifyEmail": false,
      "LogEmailsToConsole": false,
      "AllowSelfServicePlanChange": true,
      "WebBaseUrl": "http://localhost:5090"
    },
    "Alerts": {
      "MaxAttempts": 3,
      "RetryDelaySeconds": 5
    }
  }
}